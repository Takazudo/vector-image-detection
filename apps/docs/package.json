{
  "name": "@vector-image-detection/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "zfb dev",
    "build": "zfb build",
    "check": "zfb check",
    "typecheck": "pnpm run build && pnpm run check",
    "preview": "zfb preview",
    "deploy": "pnpm run build && wrangler pages deploy dist --project-name=doc-vector-image-detection",
    "setup:doc-skill": "bash scripts/setup-doc-skill.sh",
    "setup:doc-skill-silent": "bash scripts/setup-doc-skill.sh --silent",
    "setup:doc-skill:claude": "bash scripts/setup-doc-skill.sh --target claude",
    "setup:doc-skill:codex": "bash scripts/setup-doc-skill.sh --target codex",
    "setup:doc-skill:both": "bash scripts/setup-doc-skill.sh --target both"
  },
  "dependencies": {
    "@takazudo/zdtp": "0.4.9",
    "@takazudo/zfb": "2.3.0",
    "@takazudo/zfb-md-wasm": "2.3.0",
    "@takazudo/zfb-runtime": "2.3.0",
    "@takazudo/zudo-doc": "5.2.1",
    "diff": "8.0.4",
    "katex": "0.16.47",
    "minisearch": "7.2.0",
    "preact": "10.29.8",
    "preact-render-to-string": "6.7.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "pagefind": "1.5.2",
    "typescript": "5.9.3",
    "wrangler": "4.120.0"
  }
}
