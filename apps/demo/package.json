{
  "name": "@vector-image-detection/demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "zfb dev",
    "pretypecheck": "node scripts/bundle-core.mjs",
    "typecheck": "pnpm run worker:types:check && tsc -b && zfb check",
    "prebuild": "pnpm run fixture && node scripts/bundle-core.mjs",
    "build": "tsc -b && zfb build",
    "preview": "zfb preview",
    "predeploy": "node scripts/render-production-config.mjs",
    "deploy": "pnpm run build && wrangler deploy --config .wrangler.production.generated.json",
    "deploy:dry-run": "pnpm run build && wrangler deploy --dry-run --config wrangler.jsonc",
    "deploy:dry-run:production": "pnpm run build && wrangler deploy --dry-run --config wrangler.production.jsonc",
    "worker:types": "wrangler types ./src/worker/worker-configuration.d.ts --config wrangler.jsonc",
    "worker:types:check": "wrangler types ./src/worker/worker-configuration.d.ts --config wrangler.jsonc --check",
    "db:migrate:local": "wrangler d1 migrations apply vector-image-detection-demo-local --local --config wrangler.jsonc",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:dom": "vitest run --config vitest.dom.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:output": "node --test tests/output.node-test.mjs",
    "test:smoke": "node tests/browser-smoke.mjs",
    "fixture": "node scripts/copy-fixture.mjs"
  },
  "dependencies": {
    "@takazudo/zfb": "1.1.1",
    "@takazudo/zfb-runtime": "1.1.1",
    "@vector-image-detection/core": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@cloudflare/workers-types": "5.20260809.1",
    "@huggingface/transformers": "4.2.0",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.27.4",
    "jsdom": "30.0.1",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "sharp": "^0.35.3",
    "wrangler": "4.120.0"
  }
}
